---
import "../styles/tierlist.css";

const {
  title,
  description,
  heading,
  searchPlaceholder,
  bankTitle,
  active,
  bodyClass,
} = Astro.props;

const BASE = import.meta.env.BASE_URL;
---
<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" href={BASE + "favicon.svg"} type="image/svg+xml" />
</head>
<body class={bodyClass}>
  <header>
    <nav class="site-nav">
      <a class={active === "chars" ? "active" : undefined} href={BASE}>Персонажи</a>
      <a class={active === "games" ? "active" : undefined} href={BASE + "games/"}>Игры</a>
    </nav>
    <h1>RESIDENT <span>EVIL</span> — {heading}</h1>
    <span class="stamp" aria-hidden="true">Классифицировано</span>
    <input id="search" type="text" placeholder={searchPlaceholder} />
    <button id="shot" aria-pressed="false">Скриншот</button>
    <button id="reset">Сбросить</button>
  </header>

  <div id="cols">
    <div id="tiers"></div>
    <div id="poolwrap">
      <div id="poolhead"><span>{bankTitle}</span><small id="poolcount"></small></div>
      <div id="pool"></div>
    </div>
  </div>

  <dialog id="reset-dialog">
    <div id="rd-card">
      <span class="stamp" aria-hidden="true">Сброс дела</span>
      <h2 id="rd-title">Сбросить всё?</h2>
      <p id="rd-text"></p>
      <div id="rd-actions">
        <button id="rd-confirm">Сбросить</button>
        <button id="rd-cancel">Отмена</button>
      </div>
    </div>
  </dialog>

  <div id="lightbox" hidden>
    <div id="lb-card">
      <button id="lb-close" aria-label="Закрыть">
        <svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M2 2l10 10M12 2L2 12"/></svg>
      </button>
      <div id="lb-media">
        <img id="lb-img" alt="" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" />
        <button id="lb-prev" aria-label="Предыдущий">
          <svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9.5 2L4.5 7l5 5"/></svg>
        </button>
        <button id="lb-next" aria-label="Следующий">
          <svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4.5 2l5 5-5 5"/></svg>
        </button>
        <span id="lb-pos"></span>
      </div>
      <div id="lb-info">
        <h2 id="lb-name"></h2>
        <div id="lb-sub"></div>
        <div id="lb-meta" class="chips"></div>
        <div id="lb-extra"></div>
      </div>
    </div>
  </div>
</body>
</html>
