---
import "../styles/tierlist.css";

const {
  title,
  description,
  heading,
  searchPlaceholder,
  bankTitle,
  footer,
  active,
  bodyClass,
} = Astro.props;

const BASE = import.meta.env.BASE_URL;
---
<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" href={BASE + "favicon.svg"} type="image/svg+xml" />
</head>
<body class={bodyClass}>
  <header>
    <nav class="site-nav">
      <a class={active === "chars" ? "active" : undefined} href={BASE}>Персонажи</a>
      <a class={active === "games" ? "active" : undefined} href={BASE + "games/"}>Игры</a>
    </nav>
    <h1>RESIDENT <span>EVIL</span> — {heading}</h1>
    <input id="search" type="text" placeholder={searchPlaceholder} />
    <button id="reset">Сбросить</button>
  </header>

  <div id="cols">
    <div id="tiers"></div>
    <div id="poolwrap">
      <div id="poolhead"><span>{bankTitle}</span><small id="poolcount"></small></div>
      <div id="pool"></div>
    </div>
  </div>

  <footer>{footer}</footer>

  <div id="lightbox" hidden>
    <div id="lb-card">
      <button id="lb-close" aria-label="Закрыть">✕</button>
      <div id="lb-media">
        <img id="lb-img" alt="" />
        <button id="lb-prev" aria-label="Предыдущий">‹</button>
        <button id="lb-next" aria-label="Следующий">›</button>
        <span id="lb-pos"></span>
      </div>
      <div id="lb-info">
        <h2 id="lb-name"></h2>
        <div id="lb-sub"></div>
        <div id="lb-meta" class="chips"></div>
        <div id="lb-extra"></div>
      </div>
    </div>
  </div>
</body>
</html>
