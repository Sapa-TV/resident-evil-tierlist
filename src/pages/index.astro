---
import "../styles/tierlist.css";
---
<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Resident Evil — Тир-лист</title>
  <meta name="description" content="Тир-лист персонажей Resident Evil: перетаскивай карточки по линиям, смотри портреты в увеличении, всё сохраняется в браузере." />
  <link rel="icon" href={import.meta.env.BASE_URL + "favicon.svg"} type="image/svg+xml" />
</head>
<body>
  <header>
    <h1>RESIDENT <span>EVIL</span> — ТИР-ЛИСТ</h1>
    <input id="search" type="text" placeholder="Поиск персонажа…" />
    <button id="reset">Сбросить</button>
  </header>

  <div id="tiers"></div>

  <div id="poolwrap">
    <div id="poolhead"><span>Банк персонажей</span><small id="poolcount"></small></div>
    <div id="pool"></div>
  </div>

  <footer>Перетаскивай карточки мышью. Клик по карточке — увеличенная картинка. Подписи линий редактируются по двойному клику. Всё сохраняется автоматически.</footer>

  <div id="lightbox" hidden>
    <div id="lb-card">
      <button id="lb-close" aria-label="Закрыть">✕</button>
      <div id="lb-media">
        <img id="lb-img" alt="" />
        <button id="lb-prev" aria-label="Предыдущий">‹</button>
        <button id="lb-next" aria-label="Следующий">›</button>
        <span id="lb-pos"></span>
      </div>
      <div id="lb-info">
        <h2 id="lb-name"></h2>
        <div id="lb-eng"></div>
        <div id="lb-games"></div>
        <ul id="lb-attacks"></ul>
      </div>
    </div>
  </div>

  <script src="../scripts/tierlist.js"></script>
</body>
</html>
